---
/**
 * Starlight SiteTitle override: adds the version badge next to the site
 * title in the header, on the same row as the search box and the GitHub icon.
 *
 * The badge links to the latest release. Markup below mirrors the stock
 * component (node_modules/@astrojs/starlight/dist/components/SiteTitle.astro)
 * so the logo and title keep behaving identically — if Starlight changes
 * that component, copy its changes here.
 */

import { appVersion } from "../lib/version.mjs";
import config from "virtual:starlight/user-config";
import { logos } from "virtual:starlight/user-images";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const { logo } = config;
const version = await appVersion();
const releaseUrl =
  "https://github.com/juliendf/FinanceTrackerApp/releases/latest";
---

<a href={siteTitleHref} class="site-title sl-flex">
	{logo && logos.dark && (
		<img alt={logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />
	)}
	<span translate="no">{siteTitle}</span>
</a>

<a href={releaseUrl} class="site-version" title={`Latest release: v${version}`}>v{version}</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		.site-title span {
			overflow: hidden;
		}
		.site-title img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			width: auto;
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
		}
		.site-version {
			font-size: var(--sl-text-xs);
			font-weight: 600;
			line-height: 1;
			padding: 4px 8px;
			border-radius: 999px;
			border: 1px solid var(--sl-color-gray-5);
			color: var(--sl-color-gray-3);
			text-decoration: none;
			white-space: nowrap;
		}
		.site-version:hover {
			color: var(--sl-color-text-accent);
			border-color: var(--sl-color-gray-3);
		}
	}
</style>
