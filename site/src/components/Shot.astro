---
/**
 * Screenshot with a caption, resolved against the site's base path so the same
 * markdown works on the GitHub Pages project URL and on a custom domain.
 */
interface Props {
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const src = `${import.meta.env.BASE_URL}shots/${name}.png`;
---

<figure class="doc-shot">
  <img src={src} alt={alt} loading="lazy" width="1440" height="900" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
